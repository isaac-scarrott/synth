.DS_Store
*.swp

# Swift / SwiftPM (app/)
app/.build/
app/.swiftpm/

# Python (app/harness/)
__pycache__/
*.pyc

# Local scratch
*.log

# Globally-ignored on this machine, but tracked in this repo
!CONTEXT.md
!docs/
!docs/adr/
!docs/adr/**

# MCPInstaller writes all of these into every managed worktree on the autosave cadence, so
# a tracked copy is dirt in every checkout: the toggle state and the channel-dependent
# install path both differ from whatever blob was committed. `opencode.json` and Antigravity's
# `.agents/mcp_config.json` additionally carry a `SYNTH_WORKTREE` absolute path to *that*
# worktree.
/opencode.json
/.mcp.json
/.agents/mcp_config.json
